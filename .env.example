# Database Configuration
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=cafe_azzura
DB_PORT=3306

# Server Configuration
PORT=3002
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d

# File Upload Configuration
MAX_FILE_SIZE=5242880

# Storage — set STORAGE_DRIVER=s3 to use S3-compatible storage
# Set STORAGE_DRIVER=local to use local disk (default)
STORAGE_DRIVER=s3
STORAGE_S3_ENDPOINT=https://is3.cloudhost.id
STORAGE_S3_REGION=us-east-1
STORAGE_S3_KEY=your_access_key
STORAGE_S3_SECRET=your_secret_key
STORAGE_S3_BUCKET=your_bucket_name
STORAGE_S3_URL=https://your-cdn-url.example.com

# Admin Default
ADMIN_EMAIL=admin@cafeazzura.com
ADMIN_PASSWORD=admin123
